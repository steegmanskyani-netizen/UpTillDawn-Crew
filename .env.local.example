# Uptilldawn local environment
# Copy to .env.local and replace the placeholders.
# Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Geoapify Address Autocomplete / Geocoding (server-side secret)
GEOAPIFY_API_KEY=

# OpenAI Responses API (server-side only; never expose as NEXT_PUBLIC_*)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6\n